# .htaccess untuk htdocs/laravel/ (InfinityFree)
# Seluruh isi folder aplikasi TIDAK BOLEH diakses dari browser:
# .env (password database, APP_KEY), kode, log, dan bukti bayar pelanggan.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
Options -Indexes
